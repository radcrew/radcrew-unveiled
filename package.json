{
  "name": "radcrew-unveiled",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -n frontend,api -c cyan,magenta \"yarn dev:frontend\" \"yarn dev:backend\"",
    "dev:frontend": "yarn workspace frontend dev",
    "build": "yarn workspace frontend build",
    "build:frontend": "yarn workspace frontend build",
    "build:dev": "yarn workspace frontend build:dev",
    "lint": "eslint frontend/src",
    "preview": "yarn workspace frontend preview",
    "test": "yarn workspace frontend test",
    "test:watch": "yarn workspace frontend test:watch",
    "test:e2e": "yarn workspace frontend test:e2e",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8787 --reload --reload-dir app",
    "test:backend": "cd backend && python -m pytest",
    "build:backend": "cd backend && python -m compileall -q app"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.24.0",
    "@rollup/rollup-darwin-x64": "4.24.0",
    "@rollup/rollup-linux-x64-gnu": "4.24.0",
    "@rollup/rollup-win32-x64-msvc": "4.24.0",
    "@swc/core-darwin-arm64": "1.13.2",
    "@swc/core-darwin-x64": "1.13.2",
    "@swc/core-linux-x64-gnu": "1.13.2",
    "@swc/core-win32-x64-msvc": "1.13.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.38.0"
  }
}
